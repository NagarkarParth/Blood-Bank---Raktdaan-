<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"

    android:background="#FFFFFF"
    tools:context=".donorActivity">

    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#B71C1C"
        android:elevation="8dp"
        android:padding="10dp">

        <!-- Blood Bank Logo -->

        <!-- Blood Bank System Title -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="20dp"
            android:contentDescription="Blood Bank Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/newlogo" />

        <TextView
            android:id="@+id/tv_blood_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/iv_logo"
            android:text="Blood Bank System"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Register as Donor Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:backgroundTint="@color/white"
        android:background="@color/white"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- register user Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimation1"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="-4dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/registeruser" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register as a Donor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/btnRegisterDonor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register Now"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Search for Blood Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:backgroundTint="@color/white"
        android:background="@color/white"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- search Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimation"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="-4dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/searchanimation" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Search for Blood"
                android:textColor="#B71C1C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSearchBlood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Now"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textSize="18sp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        android:padding="20dp"
        android:textStyle="bold"/>

</LinearLayout>

