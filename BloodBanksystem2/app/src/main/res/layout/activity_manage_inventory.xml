<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Full-Screen Header -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#B71C1C"
        android:elevation="8dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:contentDescription="Blood Bank Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/newlogo" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_blood_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/iv_logo"
            android:text="Blood Bank System"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Form Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- Blood Group Selection -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Blood Group"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerBloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <!-- Quantity Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Quantity"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"/>

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:hint="Enter quantity"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background"/>

                <!-- Date of Collection -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date of Collection"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"/>

                <EditText
                    android:id="@+id/etDateOfCollection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/black"
                    android:background="@android:drawable/editbox_background"
                    android:padding="12dp"/>

                <!-- Horizontal Layout for Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <!-- Add Inventory Button -->
                    <Button
                        android:id="@+id/btnAddInventory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add to Inventory"
                        android:backgroundTint="@android:color/holo_red_dark"
                        android:textColor="@android:color/white"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Remove Inventory Button -->
                    <Button
                        android:id="@+id/btnRemoveInventory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Remove from Inventory"
                        android:backgroundTint="@android:color/holo_red_dark"
                        android:textColor="@android:color/white"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>


            </LinearLayout>

            <!-- Inventory List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inventory List"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="10dp"
                android:gravity="center"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewInventory"
                android:layout_width="wrap_content"
                android:layout_height="600dp"
                android:scrollbars="vertical"
                android:padding="2dp"/>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
