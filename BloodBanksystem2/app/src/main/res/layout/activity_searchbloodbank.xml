<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blood Bank System"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="#D32F2F"
            android:padding="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Blood in Blood Banks"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_gravity="center" />

        <!-- Blood Groups -->
        <!-- Group A -->
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood Group A"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_a_positive"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="A+"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/btn_a_negative"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="A-"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Repeat for other groups -->
        <!-- Group B -->
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood Group B"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_b_positive"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="B+"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/btn_b_negative"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="B-"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Group AB -->
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood Group AB"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_ab_positive"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="AB+"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/btn_ab_negative"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="AB-"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Group O -->
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood Group O"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_o_positive"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="O+"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/btn_o_negative"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="O-"
                android:backgroundTint="#D32F2F"
                android:textColor="#fff"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Search Button -->
        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textStyle="bold"
            android:textColor="#fff"
            android:backgroundTint="#D32F2F"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp" />

        <Button
            android:visibility="invisible"
            android:id="@+id/btnSearchBloodBank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search" />

    </LinearLayout>
</ScrollView>